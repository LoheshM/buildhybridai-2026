 "totals": {
  "plan": {
   "title": "Fixing Fraction Addition and Subtraction: Finding Common Denominators",
   "focus": "Addressing the add_across mistake pattern by reinforcing common denominators before adding or subtracting fractions.",
   "minutes": 15,
   "steps": [
    {
     "minutes": 3,
     "teacher": "Show 1/2 + 1/4 on the board. Remind students that add_across (adding tops and bottoms straight out) is a trap because the pieces are different sizes.",
     "students": "Observe the visual fraction strips showing why different denominators cannot be directly added."
    },
    {
     "minutes": 4,
     "teacher": "Demonstrate how to find a common denominator. Convert 1/2 to 2/4 by multiplying numerator and denominator by 2.",
     "students": "Follow along and write down the steps for finding the lowest common denominator."
    },
    {
     "minutes": 4,
     "teacher": "Work through 2/3 + 1/6 together. Show how 2/3 becomes 4/6, then add numerators to get 5/6.",
     "students": "Practice converting and adding alongside the teacher on individual whiteboards."
    },
    {
     "minutes": 4,
     "teacher": "Guide students through setting up subtraction with unlike denominators, like 3/4 - 1/3.",
     "students": "Convert both fractions to twelfths and complete the subtraction independently."
    }
   ],
