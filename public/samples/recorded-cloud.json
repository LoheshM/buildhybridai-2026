 "totals": {
  "plan": {
   "title": "Adding Fractions with Different Denominators",
   "focus": "Finding a common denominator before adding fractions instead of adding straight across.",
   "minutes": 15,
   "steps": [
    {
     "minutes": 3,
     "teacher": "The teacher displays 1/2 + 1/4 and explains that we cannot add fractions directly when the bottom numbers are different.",
     "students": "Students listen and observe that the two fraction strips have different sizes."
    },
    {
     "minutes": 4,
     "teacher": "The teacher demonstrates how to find a common denominator by converting 1/2 into 2/4.",
     "students": "Students follow along on their whiteboards, rewriting 1/2 as 2/4."
    },
    {
     "minutes": 4,
     "teacher": "The teacher guides the class to add only the top numbers while keeping the bottom number the same: 2/4 + 1/4 = 3/4.",
     "students": "Students calculate the final sum and discuss why the bottom number does not change."
    },
    {
     "minutes": 4,
     "teacher": "The teacher provides a new example, 1/3 + 1/6, and asks students to find the common denominator in pairs.",
     "students": "Students work in pairs to convert the fractions and find the correct sum of 3/6, which simplifies to 1/2."
    }
   ],
